# Example Terraform variables for VSatellite deployment
# Copy this file to terraform.tfvars and modify the values as needed

# AWS Configuration
aws_region = "us-east-1"             # AWS region for deployment

# Project configuration (used to find VPC and subnets by tags)
project_name = "terraform-cicd"      # Project name for resource discovery

# Environment configuration
environment = "dev"                  # Environment name (dev, staging, prod)

# Instance configuration
instance_type = "m7i-flex.large"      # Free Tier eligible AND meets VSatellite requirements (8GB RAM, 2 vCPUs)
use_ubuntu    = true                 # Use Ubuntu 22.04 LTS (recommended)

# Storage configuration
root_volume_size   = 30              # Root volume size in GB (minimum 15GB + OS)
create_data_volume = true            # Create additional data volume
data_volume_size   = 50              # Data volume size in GB

# Networking
associate_public_ip = false          # Manual public IP control (overridden if Instance Connect enabled)
create_elastic_ip   = false          # Create Elastic IP (optional, for static IP)
enable_instance_connect = true       # Enable EC2 Instance Connect (automatically assigns public IP)
# SSH not needed - using AWS Session Manager console connection

# VSatellite configuration
use_install_dir_option  = true       # Use --install-dir option (recommended)
vsatellite_install_dir  = "/opt/vsatellite" # Custom installation directory
vsatellite_version      = ""         # Leave empty for latest version
vsatellite_name         = "vsatellite-dev" # Name in CyberArk console

cyberark_tenant_url = "https://api.venafi.cloud"
# vsatellite_api_key  = "your-api-key-here"  # Will be stored securely in SSM

# Monitoring and management
enable_detailed_monitoring     = false  # Enable detailed CloudWatch monitoring
enable_termination_protection  = false  # Enable termination protection
backup_retention_days          = 7      # Backup retention period

# Tags
tags = {
  Project     = "terraform-cicd"
  Environment = "dev"
}